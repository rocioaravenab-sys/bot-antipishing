# --- Discord ---
# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=pega_aqui_tu_token

# (Opcional) ID de tu servidor: registra el comando /analizar al instante.
# Sin esto, el comando global puede tardar hasta ~1 hora en aparecer.
GUILD_ID=

# (Opcional) Enlace de donación para el botón "Invítame un café".
# Si se deja vacío, usa el de Mercado Pago por defecto.
DONATION_URL=

# --- Threat Intelligence (todas OPCIONALES) ---
# El bot funciona sin estas claves usando solo heurísticas,
# pero con ellas la detección es mucho más precisa.

# Google Safe Browsing: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus (abuse.ch) Auth-Key: https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=

# --- Comportamiento ---
# Si es "true", el bot expande acortadores (bit.ly, etc.) siguiendo
# redirecciones SOLO con peticiones HEAD (nunca envía datos).
EXPAND_SHORTENERS=true

# Nº máximo de redirecciones a seguir al expandir
MAX_REDIRECTS=5

# Timeout (segundos) para peticiones de red
REQUEST_TIMEOUT=8
