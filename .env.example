# --- Discord ---
# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=pega_aqui_tu_token

# (Opcional) ID de tu servidor: registra el comando /analizar al instante.
# Sin esto, el comando global puede tardar hasta ~1 hora en aparecer.
GUILD_ID=

# (Opcional) Enlace de donación para el botón "Invítame un café".
# Si se deja vacío, usa el de Mercado Pago por defecto.
DONATION_URL=

# --- Threat Intelligence (todas OPCIONALES) ---
# El bot funciona sin estas claves usando solo heurísticas,
# pero con ellas la detección es mucho más precisa.

# Google Safe Browsing: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus (abuse.ch) Auth-Key: https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=

# --- Intel de dominio (sin claves) ---
# Antigüedad del dominio (RDAP) + inspección del certificado TLS.
# Ponlo en "false" si añade demasiada latencia por consulta.
DOMAIN_INTEL=true
RDAP_BASE=https://rdap.org

# --- Clasificador de smishing con IA ---
# Señal extra: suma puntos si el texto parece smishing (p. ej. "hola mamá,
# cambié de número" sin enlace). Nunca baja un veredicto. Sin configurar = apagado.
# Antes de enviar el texto se ocultan teléfonos, RUT y correos.
AI_CLASSIFIER=true
AI_TIMEOUT=8

# Opción A — Qwen (u otro modelo) por una API compatible con OpenAI.
# AI_BASE_URL termina en /v1; el nombre exacto del modelo se copia del panel
# del proveedor (cambian seguido). Ejemplos de AI_BASE_URL:
#   Alibaba Model Studio (Singapur): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Groq:                            https://api.groq.com/openai/v1
#   OpenRouter:                      https://openrouter.ai/api/v1
#   Ollama propio:                   http://localhost:11434/v1   (sin AI_API_KEY)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Ponlo en "false" si el proveedor responde 400 por 'response_format'.
AI_JSON_MODE=true

# Opción B — Claude: deja AI_BASE_URL vacío y define solo esta clave
# (https://console.anthropic.com/). AI_MODEL por defecto: claude-haiku-4-5.
ANTHROPIC_API_KEY=
# Fuerza el proveedor si defines ambas: "openai" o "anthropic".
AI_PROVIDER=

# --- Rate limiting de la API (token bucket in-process, por X-Install-Id o IP) ---
RATE_LIMIT=true
RL_ANALYZE_PER_MIN=20
RL_TEXT_PER_MIN=60
RL_RULES_PER_HOUR=30

# --- Comportamiento ---
# Si es "true", el bot expande acortadores (bit.ly, etc.) siguiendo
# redirecciones SOLO con peticiones HEAD (nunca envía datos).
EXPAND_SHORTENERS=true

# Nº máximo de redirecciones a seguir al expandir
MAX_REDIRECTS=5

# Timeout (segundos) para peticiones de red
REQUEST_TIMEOUT=8
